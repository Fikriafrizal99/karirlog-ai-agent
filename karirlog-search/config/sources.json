{
  "http": {
    "timeout_seconds": 20,
    "retry_total": 2,
    "retry_backoff_seconds": 0.8,
    "user_agent": "KarirLog-AI-Agent/1.2 (+personal job discovery; respectful request rate)"
  },
  "sources": [
    {
      "type": "brave_search",
      "name": "Brave - Manual Handoff Search",
      "enabled": true,
      "api_key_env": "BRAVE_SEARCH_API_KEY",
      "queries_per_run": 12,
      "roles_per_query": 4,
      "results_per_query": 20,
      "country": "ID",
      "freshness": "pm",
      "hydrate_pages": true,
      "strict_detail_filter": true,
      "generic_detail_min_score": 3,
      "max_explicit_age_days": 45,
      "min_description_chars": 80,
      "min_generic_description_chars": 120,
      "require_location": false,
      "require_target_role_match": true,
      "role_match_min_ratio": 0.5,
      "allow_global_remote": false,
      "reject_company_pages": true,
      "max_structured_jobs_per_page": 10,
      "cache_enabled": true,
      "cache_dir": "data/cache/brave",
      "cache_ttl_hours": 24,
      "cache_only": false,
      "force_refresh_cache": false,
      "extra_snippets": true,
      "search_pages_per_query": 1,
      "max_search_requests_per_run": 12,
      "max_hydration_attempts": 80,
      "prehydrate_min_score": 1,
      "diagnostics_path": "data/output/latest_discovery_diagnostics.json",
      "source_scoped_queries": false,
      "expand_role_or_queries": false,
      "include_grouped_queries": true,
      "queries": [
        "(\"Branch Marketing Head\" OR \"Marketing Supervisor\")",
        "(\"Sales Supervisor\" OR \"Area Sales Supervisor\")",
        "(\"Territory Sales Supervisor\" OR \"Team Leader Sales\")",
        "(\"Sales Coordinator\" OR \"Sales Operations\")",
        "(\"Relationship Officer\" OR \"Relationship Manager\")",
        "\"Dealer Relationship Officer\"",
        "(\"Sales Team Leader\" OR \"Branch Sales Supervisor\" OR \"Marketing Head\")",
        "(\"Operations Coordinator\" OR \"Operations Executive\" OR \"Business Operations\" OR \"Service Operations\")",
        "(\"Project Coordinator\" OR \"Project Administrator\" OR \"Project Support\" OR \"Program Coordinator\")",
        "(\"Business Development\" OR \"Partnership Executive\" OR \"Partnership Specialist\" OR \"Partner Operations\")",
        "(\"Commercial Executive\" OR \"Commercial Operations\" OR \"Business Support\" OR \"Process Improvement\")",
        "(\"Customer Success\" OR \"Customer Experience\" OR \"Client Relations\" OR \"Client Service\")"
      ],
      "selected_source_groups": [
        "kitalulus",
        "jobstreet",
        "linkedin",
        "kalibrr",
        "glints",
        "career_sites"
      ],
      "brave_parameter_mode": "country_only",
      "role_aliases": {
        "Management Trainee": [
          "Officer Development Program",
          "ODP",
          "Management Development Program",
          "MDP",
          "Graduate Development Program"
        ],
        "Team Leader Sales": [
          "Sales Team Leader"
        ],
        "Sales Operations": [
          "Sales Operation"
        ],
        "Business Development": [
          "Business Development Representative",
          "BDR"
        ]
      },
      "excluded_domains": [
        "facebook.com",
        "instagram.com",
        "youtube.com",
        "tiktok.com",
        "jobleads.com",
        "dailyremote.com",
        "usaremotejobs.app",
        "remotezest.up.railway.app",
        "executiveplacements.com"
      ]
    },
    {
      "type": "url_list",
      "name": "Direct Job URLs",
      "enabled": false,
      "path": "data/input/job_urls.txt",
      "strict_jobposting": false
    },
    {
      "type": "rss",
      "name": "Public Job Feeds",
      "enabled": false,
      "feeds": [],
      "hydrate_pages": true
    },
    {
      "type": "csv",
      "name": "CSV Job Collector",
      "enabled": true,
      "path": "data/input/Job_List.csv",
      "fallback_only": true
    }
  ]
}
